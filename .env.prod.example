# /opt/groups/.env (API + database)

POSTGRES_DB=groups
POSTGRES_USER=groups
# no "@ : / #" here, the password goes inside the database URL
POSTGRES_PASSWORD=

# OpenWA runs on the same server, reached through OHenriquecedorNet
OPENWA_BASEURL=http://openwa_openwa:2785
OPENWA_ADMIN_APIKEY=
OPENWA_SESSION_ID=

# openssl rand -hex 32 (each)
WEBHOOK_TOKEN=
API_KEY=

SYNC_INTERVAL=6h
